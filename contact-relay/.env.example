# Copy to .env (gitignored) and fill in. The relay runs without these but answers
# "Not connected yet" to every submission until they are set.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where messages land; defaults to GMAIL_USER when empty.
CONTACT_TO=
SITE_ORIGIN=https://beronilla.rodeo
# Attempts per sender address per window, and from everyone per window.
RATE_LIMIT=3
RATE_WINDOW=3600
GLOBAL_LIMIT=30
