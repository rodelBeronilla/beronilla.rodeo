# Caddy handles HTTPS certificates automatically. This mirrors the live vhost in plex-stack.
www.beronilla.rodeo {
    redir https://beronilla.rodeo{uri} permanent
}

beronilla.rodeo {
    root * /srv/beronilla.rodeo/site
    # The contact form posts here. The relay (projects/webapp-hosting/contact-relay, joined to
    # media-net as contact-relay) turns it into an email, so the address is never in the page.
    @contact path /contact /contact/challenge
    handle @contact {
        request_body {
            max_size 64KB
        }
        reverse_proxy contact-relay:8080
    }
    encode zstd gzip
    # Pages are fresh within a minute, and Cloudflare may serve its last copy for a day if this
    # server errors. No s-maxage: Cloudflare ignores stale-if-error when s-maxage is set.
    # Assets are versioned by the deploy script (style.css?v=hash), so they cache for a week.
    @page path / /index.html /404.html /sent.html
    header @page Cache-Control "public, max-age=60, stale-if-error=86400"
    @asset path *.css *.js *.svg
    header @asset Cache-Control "public, max-age=604800"
    file_server
    handle_errors {
        @404 expression {http.error.status_code} == 404
        rewrite @404 /404.html
        file_server
    }
    header {
        Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-B/Lg1CTCd7lLGp9NoXqJXOWxw2axp951s1WKy6Qg6HI='; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Cross-Origin-Opener-Policy "same-origin"
    }
}
