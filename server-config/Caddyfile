# Caddy handles HTTPS certificates automatically.
www.beronilla.rodeo {
    redir https://beronilla.rodeo{uri} permanent
}

beronilla.rodeo {
    root * /srv/beronilla.rodeo/site
    encode zstd gzip
    file_server
    handle_errors {
        @404 expression {http.error.status_code} == 404
        rewrite @404 /404.html
        file_server
    }
    header {
        Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-B/Lg1CTCd7lLGp9NoXqJXOWxw2axp951s1WKy6Qg6HI='; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Cross-Origin-Opener-Policy "same-origin"
    }
}
